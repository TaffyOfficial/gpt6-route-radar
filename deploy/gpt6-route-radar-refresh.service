[Unit]
Description=Collect Route Radar and upload a snapshot to Cloudflare R2
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=route-radar
Group=route-radar
EnvironmentFile=/etc/gpt6-route-radar/r2-upload.env
ExecStart=/usr/bin/python3 /opt/gpt6-route-radar/publish_r2.py
StateDirectory=gpt6-route-radar
UMask=0077
TimeoutStartSec=900
Nice=10
CPUQuota=50%
MemoryMax=256M
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
