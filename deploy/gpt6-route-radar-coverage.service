[Unit]
Description=Fill missing intelligence results for the current top seven after market refresh
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=route-radar
Group=route-radar
EnvironmentFile=/etc/gpt6-route-radar/codego.env
EnvironmentFile=/etc/gpt6-route-radar/r2-upload.env
ExecStart=/usr/bin/python3 /opt/gpt6-route-radar/intelligence.py --top7-only
ExecStartPost=/usr/bin/python3 /opt/gpt6-route-radar/publish_r2.py
StateDirectory=gpt6-route-radar
UMask=0077
TimeoutStartSec=4h
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
